# Local development secrets template.
# Copy this file to `.dev.vars` (gitignored) and replace with your own values.
# In Cloudflare production, register secrets using `npx wrangler secret put <KEY>`.

# Random secret string (32+ chars) used to sign HttpOnly session & OAuth state cookies
# Generate with: npm run generate-secret
SESSION_SECRET=change-me-to-a-long-random-session-secret-string

# Access control (choose one):
# 1) Open to anyone with a verified email / Google / GitHub account:
ALLOW_PUBLIC_SIGNUP=true
# 2) Or restrict to specific emails only (remove ALLOW_PUBLIC_SIGNUP or set false):
# ALLOWED_EMAILS=me@example.com,teammate@example.com

# Login Method 1: Google OAuth 2.0 + PKCE
# Authorized Redirect URI: https://<your-worker-url>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Login Method 2: GitHub OAuth 2.0 + PKCE
# Authorization Callback URL: https://<your-worker-url>/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Login Method 3: Email 6-digit OTP via Resend
# RESEND_API_KEY=your-resend-api-key
# MAIL_FROM=Private Todo <auth@yourdomain.com>

# Local dev only (ignored outside localhost): prints the 6-digit OTP to your terminal
DEV_OTP_CONSOLE=true

# Login Method 4 (Optional): Cloudflare Access (Zero Trust)
# CF_ACCESS_ENABLED=true
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag
