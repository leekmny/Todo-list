{
  "name": "private-todo",
  "version": "2.0.0",
  "license": "MIT",
  "author": "leekmny",
  "repository": "https://github.com/leekmny/Todo-list",
  "private": true,
  "type": "module",
  "main": "dist/electron/electron/main.cjs",
  "description": "Encrypted desktop & Cloudflare Workers todo workspace with Google/GitHub OAuth and Email OTP",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web-only": "vite build --config vite.desktop.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/rename-electron-cjs.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "desktop:dev": "npm run build:web-only && npm run build:electron && electron .",
    "desktop:dist:win": "npm run build:icon && npm run build:web-only && npm run build:electron && electron-builder --win --config electron-builder.yml",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "generate-secret": "node scripts/generate-secret.mjs",
    "check:public": "node scripts/check-public-safe.mjs"
  },
  "dependencies": {
    "hono": "^4.13.20",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.166.0"
  }
}
